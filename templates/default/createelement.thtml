<style type="text/css">
#staticpage,
#topic {
    display: none;
}
</style>

<div class="glfform">
  <form method="post" action="{form_action}" id="newitem">
    <div>
    <input type="hidden" id="menunid" name="menuid" value="{menuid}"{xhtml}>
      <div id="parentdiv" class="required">
        <p><label for="pid">{LANG_MENU01[parent]}:</label>
        {parent_select}</p>
      </div>
      <div class="required">
        <p><label for="menulabel">{LANG_MENU01[elementlabel]}:</label>
        <input class="fValidate['required']" type="text" id="menulabel" name="menulabel" size="48" value="{menulabel}"{xhtml}></p>
      </div>
      <div id="displayafter" class="required">
        <p><label for="menuorder">{LANG_MENU01[display_after]}:</label>
        {order_select}</p>
      </div>
      <div class="required">
        <p><label for="menutype">{LANG_MENU01[type]}:</label>
        {type_select}</p>
      </div>

      <div id="urldiv" class="required" style="display:none;">
        <p><label for="menuurl">{LANG_MENU01[url]}:</label>
        <input type="text" id="menuurl" name="menuurl" size="48" value="{menuurl}"{xhtml}></p>
      </div>

      <div id="targetdiv" class="required" style="display:none;">
        <p><label for="urltarget">{LANG_MENU01[target]}:</label>
        <select id="urltarget" name="urltarget">
          <option value="">{LANG_MENU01[same_window]}</option>
          <option value="_blank">{LANG_MENU01[new_window]}</option>
        </select></p>
      </div>

      <div id="glfunc" class="optional" style="display:none;">
        <p><label for="glfunction">{LANG_MENU01[geeklog_function]}:</label>
        {glfunction_select}</p>
      </div>

      <div id="glcorediv" class="optional" style="display:none;">
        <p><label for="gltype">{LANG_MENU01[coretype]}:</label>
        {gl_select}</p>
      </div>

      <div id="plugin" class="optional" style="display:none;">
        <p><label for="pluginname">{LANG_MENU01[plugins]}:</label>
        {plugin_select}</p>
      </div>

      {sp_select}

      {topic_select}

      <div id="phpdiv" class="required" style="display:none;">
        <p><label for="phpfunction">{LANG_MENU01[php]}:</label>
        <input type="text" id="phpfunction" name="phpfunction" size="48" value="{phpfunction}"{xhtml}></p>
      </div>

      <div class="required">
        <p><label for="menuactive">{LANG_MENU01[active]}:</label>
        <input type="checkbox" id="menuactive" name="menuactive" value="1"{xhtml}></p>
      </div>
      <div class="required">
        <p><label for="group">{LANG_MENU01[permission]}:</label>
        {group_select}</p>
      </div>
    <div style="text-align:center;padding-top:20px;padding-bottom:10px;">
      <input type="hidden" id="mode" name="mode" value="save"{xhtml}>
      <input type="submit" id="execute" name="execute" value="{LANG_MENU01[save]}"{xhtml}>&nbsp;&nbsp;
    </div>
  </div>
  </form>
</div>

<script type="text/javascript">
jQuery(function () {
    var select = jQuery('#menutype');
    var panels = '#urldiv,#targetdiv,#glfunc,#glcorediv,#plugin,#staticpage,#topic,#phpdiv';
    var adminOrder = ['2', '3', '4', '5', '9', '6', '1', '8', '7'];

    function orderTypes() {
        var options = {};
        var remaining = [];

        select.find('option').each(function () {
            var option = jQuery(this).detach();
            var value = String(option.val());
            options[value] = option;
            remaining.push(value);
        });

        jQuery.each(adminOrder, function (index, value) {
            if (options[value]) {
                select.append(options[value]);
                delete options[value];
            }
        });

        jQuery.each(remaining, function (index, value) {
            if (options[value]) {
                select.append(options[value]);
                delete options[value];
            }
        });

        if (select.find('option[value="2"]').length) {
            select.val('2');
        } else if (select.find('option').length) {
            select.prop('selectedIndex', 0);
        }
    }

    function syncElementFields() {
        var type = String(select.val() || '');
        jQuery(panels).hide();

        switch (type) {
            case '1': // Submenu: optional clickable URL
                jQuery('#urldiv').show();
                break;
            case '2': // Geeklog Action
                jQuery('#glfunc').show();
                break;
            case '3': // Geeklog Core
                jQuery('#glcorediv').show();
                break;
            case '4': // Plugin
                jQuery('#plugin').show();
                break;
            case '5': // Static Page
                jQuery('#staticpage').show();
                break;
            case '6': // External URL
                jQuery('#urldiv,#targetdiv').show();
                break;
            case '7': // PHP Function
                jQuery('#phpdiv').show();
                break;
            case '8': // Label only
                break;
            case '9': // Topic
                jQuery('#topic').show();
                break;
        }
    }

    orderTypes();
    select.off('change.menuElementEditor').on('change.menuElementEditor', syncElementFields);
    syncElementFields();
});
</script>
